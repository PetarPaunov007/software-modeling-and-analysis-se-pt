ter, receiver&lt;br&gt;DimCountry е свързано към DimUser и DimCompany (снежинка)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;strokeColor=#999999;fillColor=#f5f5f5;spacing=8;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1450" y="0" width="450" height="130" as="geometry"/></mxCell><mxCell id="v123" value="LinkedIn – Data Warehouse (3 факта, 7 измерения)" style="text;html=1;fontSize=26;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="0" y="-80" width="900" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>